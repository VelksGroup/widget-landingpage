# Copy to .env.local (gitignored) and fill in real values.
#
# VELKS Demo Factory — a dedicated Supabase project (org: YVA Medium), isolated
# from any other Supabase project this app might one day use. Kept as its own
# "DEMO_" namespace on purpose so nothing else in the app can accidentally
# start depending on the demo runtime's database.
#
# Browser-safe (RLS-restricted to published demo data only):
VITE_DEMO_SUPABASE_URL=
VITE_DEMO_SUPABASE_ANON_KEY=

# Server-side only — used by scripts/demo-publish.mjs and the /api/demo/[slug]
# function's own env on Vercel. NEVER expose this in client code or commit it.
DEMO_SUPABASE_SERVICE_ROLE_KEY=

# Optional — enables the stock-image fallback in the batch publisher when a
# prospect has no local photos and no direct image URLs.
PEXELS_API_KEY=
